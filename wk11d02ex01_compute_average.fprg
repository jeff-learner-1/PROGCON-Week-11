<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="AVERAGE.1"/>
        <attribute name="authors" value="USER"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-25 01:19:24 PM"/>
        <attribute name="created" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0wOS0yNTsxMTozNzowOSBBTTsyNjY5"/>
        <attribute name="edited" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0wOS0yNTswMToxOToyNCBQTTszOzI3OTA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numbers" type="Integer" array="True" size="5"/>
            <declare name="total" type="Integer" array="False" size=""/>
            <declare name="count" type="Integer" array="False" size=""/>
            <declare name="num" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="average" type="Real" array="False" size=""/>
            <output expression="&quot;Hey there! This program displays the average of the numbers you input.&quot;" newline="True"/>
            <output expression="&quot;How many numbers do you need the program to average?&quot;" newline="True"/>
            <input variable="num"/>
            <assign variable="total" expression="0"/>
            <assign variable="count" expression="0"/>
            <for variable="i" start="0" end="Size(numbers) - 1" direction="inc" step="1">
                <output expression="&quot;Input the value of the &quot; &amp; (i + 1) &amp; &quot; number&quot;" newline="True"/>
                <input variable="numbers[i]"/>
            </for>
            <for variable="i" start="0" end="Size(numbers) - 1" direction="inc" step="1">
                <assign variable="num" expression="numbers[i]"/>
                <if expression="num == 0">
                    <then/>
                    <else>
                        <assign variable="total" expression="total + num"/>
                        <assign variable="count" expression="count + 1"/>
                    </else>
                </if>
                <if expression="count == 0">
                    <then>
                        <output expression="0.0" newline="True"/>
                    </then>
                    <else>
                        <assign variable="average" expression="total / count"/>
                    </else>
                </if>
            </for>
            <output expression="average" newline="True"/>
        </body>
    </function>
</flowgorithm>

