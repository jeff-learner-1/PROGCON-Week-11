"""
PROGCON Week 11 - Test Results and Reflection Summary
GitHub Repository URL: https://github.com/jeff-learner-1/PROGCON-Week-11

1. Four Test Arrays and Averages:
   - [22, 9, 0, 17] -> Sum: 48, Count: 4, Average: 12.0
   - [22, 0, 49, 8] -> Sum: 79, Count: 4, Average: 19.75
   - [35, 13, 22, 0] -> Sum: 70, Count: 4, Average: 17.5
   - [10, 5, -4, 27] -> Sum: 38, Count: 4, Average: 9.5

2. Correctness Judgments and Reflections:
   - All calculated averages matched the expected manual outputs accurately.
   - The program correctly handled zero values and negative numbers without logic errors.
"""
<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="AVERAGE.1"/>
        <attribute name="authors" value="USER"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-28 11:15:10 AM"/>
        <attribute name="created" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0wOS0yNTsxMTozNzowOSBBTTsyNjY5"/>
        <attribute name="edited" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0wOS0yODsxMToxNToxMCBBTTs1OzI3NzI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numbers" type="Integer" array="True" size="4"/>
            <declare name="total" type="Integer" array="False" size=""/>
            <declare name="count" type="Integer" array="False" size=""/>
            <declare name="num" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="average" type="Real" array="False" size=""/>
            <output expression="&quot;Hey there! This program displays the average of the numbers you input.&quot;" newline="True"/>
            <output expression="&quot;How many numbers do you need the program to average?&quot;" newline="True"/>
            <input variable="num"/>
            <assign variable="total" expression="0"/>
            <assign variable="count" expression="0"/>
            <for variable="i" start="0" end="Size(numbers) - 1" direction="inc" step="1">
                <output expression="&quot;Input the value of the &quot; &amp; (i + 1) &amp; &quot; number&quot;" newline="True"/>
                <input variable="numbers[i]"/>
            </for>
            <for variable="i" start="0" end="Size(numbers) - 1" direction="inc" step="1">
                <assign variable="num" expression="numbers[i]"/>
                <assign variable="total" expression="total + num"/>
                <assign variable="count" expression="count + 1"/>
                <if expression="count == 0">
                    <then>
                        <output expression="0.0" newline="True"/>
                    </then>
                    <else>
                        <assign variable="average" expression="total / count"/>
                    </else>
                </if>
            </for>
            <output expression="average" newline="True"/>
        </body>
    </function>
    <function name="computeAverage" type="Real" variable="total / count">
        <parameters>
            <parameter name="numbers" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="total" type="Integer" array="False" size=""/>
            <declare name="count" type="Integer" array="False" size=""/>
            <declare name="num" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="total" expression="0"/>
            <assign variable="count" expression="0"/>
            <for variable="i" start="0" end="Size(numbers) - 1" direction="inc" step="1">
                <assign variable="num" expression="numbers[i]"/>
                <if expression="num == 0">
                    <then>
                        <assign variable="total" expression="total + num"/>
                        <assign variable="count" expression="count + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
